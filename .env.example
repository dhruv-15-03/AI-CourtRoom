# Local demo stack config (docker-compose.yml at repo root).
# Copy to .env and edit if you want non-default values -- the stack works with the
# defaults below out of the box, no external accounts required.
#
# .env is git-ignored. NEVER commit a real API key or secret here.

# --- Database (MySQL container) ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=ai_courtroom
MYSQL_USER=court_app
MYSQL_PASSWORD=court_app_pass

# --- Backend ---
# JWT signing secret. Must be >= 32 chars (see JwtConstants.java). Generate your own
# for anything beyond a throwaway local demo, e.g.:
#   openssl rand -base64 48
JWT_SECRET=local-demo-jwt-secret-change-me-please-64-characters-minimum-xx

# --- AI features (OPTIONAL) ---
# The only key you might want to add for the in-app Gemini chatbot assistant. Leave
# blank to run the demo without it -- everything else (auth, cases, dashboards,
# chat) works fine without any AI key.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-1.5-flash

# ML/RAG microservice (github.com/dhruv-15-03/AI-court-AI). Defaults to the hosted
# instance so AI case-analysis features work without running that service yourself.
# It may be asleep (free tier) -- first call can take 30-60s to wake up.
AI_SERVICE_URL=https://ai-court-ai.onrender.com/api
AI_SERVICE_API_KEY=
